{
  "swagger": "2.0",
  "info": {
    "title": "v1/telemetry.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "TelemetryService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/fleet/status/batch": {
      "post": {
        "summary": "Unary: query the latest status of a fleet. Exposed as REST via grpc-gateway.",
        "operationId": "TelemetryService_GetFleetStatus2",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetFleetStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1GetFleetStatusRequest"
            }
          }
        ],
        "tags": [
          "TelemetryService"
        ]
      }
    },
    "/v1/fleet/{fleetId}/status": {
      "get": {
        "summary": "Unary: query the latest status of a fleet. Exposed as REST via grpc-gateway.",
        "operationId": "TelemetryService_GetFleetStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetFleetStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "fleetId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "lastNRows",
            "description": "How many recent frames to aggregate per agent.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          }
        ],
        "tags": [
          "TelemetryService"
        ]
      }
    }
  },
  "definitions": {
    "AlertNotificationSeverity": {
      "type": "string",
      "enum": [
        "SEVERITY_UNSPECIFIED",
        "SEVERITY_INFO",
        "SEVERITY_WARNING",
        "SEVERITY_CRITICAL"
      ],
      "default": "SEVERITY_UNSPECIFIED"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1AgentStatusSummary": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "avgCpuUtilizationPct": {
          "type": "number",
          "format": "double"
        },
        "lastSeenUnixMs": {
          "type": "string",
          "format": "uint64"
        },
        "status": {
          "$ref": "#/definitions/AlertNotificationSeverity"
        }
      }
    },
    "v1AlertNotification": {
      "type": "object",
      "properties": {
        "alertId": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "fleetId": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/AlertNotificationSeverity"
        },
        "message": {
          "type": "string"
        },
        "triggeredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1GetFleetStatusRequest": {
      "type": "object",
      "properties": {
        "fleetId": {
          "type": "string"
        },
        "lastNRows": {
          "type": "integer",
          "format": "int64",
          "description": "How many recent frames to aggregate per agent."
        }
      }
    },
    "v1GetFleetStatusResponse": {
      "type": "object",
      "properties": {
        "fleetId": {
          "type": "string"
        },
        "activeAgentCount": {
          "type": "integer",
          "format": "int64"
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AgentStatusSummary"
          }
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1NetworkMetrics": {
      "type": "object",
      "properties": {
        "rxMbps": {
          "type": "number",
          "format": "double"
        },
        "txMbps": {
          "type": "number",
          "format": "double"
        },
        "tcpRetransmitCount": {
          "type": "string",
          "format": "uint64"
        },
        "connectionCount": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "v1StreamAck": {
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "type": "string"
        },
        "serverReceivedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1StreamResponse": {
      "type": "object",
      "properties": {
        "ack": {
          "$ref": "#/definitions/v1StreamAck"
        },
        "alert": {
          "$ref": "#/definitions/v1AlertNotification"
        }
      }
    },
    "v1SystemMetrics": {
      "type": "object",
      "properties": {
        "cpuUtilizationPct": {
          "type": "number",
          "format": "double",
          "title": "0.0 – 100.0"
        },
        "memoryUsedBytes": {
          "type": "string",
          "format": "uint64"
        },
        "memoryTotalBytes": {
          "type": "string",
          "format": "uint64"
        },
        "diskIoReadMbps": {
          "type": "number",
          "format": "double"
        },
        "diskIoWriteMbps": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
